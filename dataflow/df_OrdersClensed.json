{
	"name": "df_OrdersClensed",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_blob_orders",
						"type": "DatasetReference"
					},
					"name": "allOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sql_factOrders",
						"type": "DatasetReference"
					},
					"name": "LoadOrders"
				}
			],
			"transformations": [
				{
					"name": "CleanOrders"
				},
				{
					"name": "NewColumns"
				},
				{
					"name": "FinalOrders"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          OrderDate as date 'yyyy-MM-dd',",
				"          Quantity as short,",
				"          UnitPrice as integer,",
				"          Discount as double,",
				"          ShippingCost as short,",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['orders/month*/orders_*.csv']) ~> allOrders",
				"allOrders filter((!isNull(OrderId) && length(trim(OrderId))>0)) ~> CleanOrders",
				"CleanOrders derive(GrossRevenue = Quantity * UnitPrice,",
				"          DiscountAmount = Quantity *UnitPrice*Discount,",
				"          NetRevenue = Quantity*UnitPrice*(1-Discount),",
				"          TotalRevenue = (Quantity*UnitPrice*(1-Discount))+ShippingCost,",
				"          IsDeliverd = equals(OrderStatus, 'Delivered'),",
				"          OrderYear = year(OrderDate),",
				"          OrderMonth = month(OrderDate)) ~> NewColumns",
				"NewColumns select(mapColumn(",
				"          OrderId,",
				"          CustomerId,",
				"          ProductId,",
				"          OrderDate,",
				"          Quantity,",
				"          UnitPrice,",
				"          DiscountPct = Discount,",
				"          ShippingCost,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          Region,",
				"          GrossRevenue,",
				"          DiscountAmount,",
				"          NetRevenue,",
				"          IdDeliverd = IsDeliverd,",
				"          OrderYear,",
				"          OrderMonth",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FinalOrders",
				"FinalOrders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          OrderMonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          DiscountPct as decimal(5,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostOfGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          IsDelivered as boolean,",
				"          Region as string,",
				"          LoadedAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['Truncate table fact_orders'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> LoadOrders"
			]
		}
	}
}