{
	"name": "df_EnrichOrders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_sql_factOrders",
						"type": "DatasetReference"
					},
					"name": "factOrders"
				},
				{
					"dataset": {
						"referenceName": "ds_blob_customers",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "ds_blob_product",
						"type": "DatasetReference"
					},
					"name": "Product"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sql_factOrders",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "OrderwithCustomer"
				},
				{
					"name": "withProductname"
				},
				{
					"name": "withProfit"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          OrderMonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          DiscountPct as decimal(5,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostOfGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          IsDelivered as boolean,",
				"          Region as string,",
				"          LoadedAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> factOrders",
				"source(output(",
				"          CustomerId as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Phone as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          CustomerSegment as string,",
				"          JoinDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Customers",
				"source(output(",
				"          ProductId as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          SubCategory as string,",
				"          Brand as string,",
				"          UnitPrice as integer,",
				"          CostPrice as integer,",
				"          StockQty as integer,",
				"          Supplier as string,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Product",
				"factOrders, Customers join(factOrders@CustomerId == Customers@CustomerId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrderwithCustomer",
				"OrderwithCustomer, Product join(factOrders@ProductId == Product@ProductId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> withProductname",
				"withProductname derive(CostOfGoods = Quantity*CostPrice) ~> withProfit",
				"withProfit sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          OrderMonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          DiscountPct as decimal(5,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostOfGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          IsDelivered as boolean,",
				"          Region as string,",
				"          LoadedAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}