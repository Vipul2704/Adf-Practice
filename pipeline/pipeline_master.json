{
	"name": "pipeline_master",
	"properties": {
		"activities": [
			{
				"name": "LoadDimension",
				"description": "This pipeline is for to load the dimension",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pipeline_CopyDimension",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "LoadCleansOrder",
				"description": "this pipeline is for to load the orders fact table",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "LoadDimension",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pipeline_LoadOrders",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "LoadtheEnrichData",
				"description": "to insert the pending blank data into sql",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "LoadCleansOrder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "df_EnrichOrders",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "NotifiedOfSucess",
				"description": "Notification of sucess",
				"type": "WebHook",
				"dependsOn": [
					{
						"activity": "LoadtheEnrichData",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": "https://webhook.site/88eaf54f-0d84-48cb-8014-73de04480ec7",
					"method": "POST",
					"body": {
						"value": "{\"pipeline\": \"@pipeline().pipeline}\",\n\"status\":\"Sucess\",\n\"runId\":\"@{pipeline().RunId}\",\n\"completedAt\": \"@{utcnow()}\",\n\"message\":\"Shopy Easy Pipeline completed sucessfully\"\n}",
						"type": "Expression"
					},
					"timeout": "00:10:00"
				}
			}
		],
		"parameters": {
			"Master": {
				"type": "string",
				"defaultValue": "Full"
			}
		},
		"annotations": []
	}
}