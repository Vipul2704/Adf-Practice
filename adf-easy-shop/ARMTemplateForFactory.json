		{
			"name": "[concat(parameters('factoryName'), '/df_EnrichOrders')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_sql_factOrders",
								"type": "DatasetReference"
							},
							"name": "factOrders"
						},
						{
							"dataset": {
								"referenceName": "ds_blob_customers",
								"type": "DatasetReference"
							},
							"name": "Customers"
						},
						{
							"dataset": {
								"referenceName": "ds_blob_product",
								"type": "DatasetReference"
							},
							"name": "Product"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_sql_factOrders",
								"type": "DatasetReference"
							},
							"name": "LoadEnrichOrder"
						}
					],
					"transformations": [
						{
							"name": "OrderwithCustomer"
						},
						{
							"name": "withProductname"
						},
						{
							"name": "withProfit"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          OrderId as string,",
						"          CustomerId as string,",
						"          ProductId as string,",
						"          CustomerName as string,",
						"          ProductName as string,",
						"          Category as string,",
						"          OrderDate as date,",
						"          OrderMonth as integer,",
						"          OrderYear as integer,",
						"          Quantity as integer,",
						"          UnitPrice as decimal(10,2),",
						"          DiscountPct as decimal(5,2),",
						"          DiscountAmount as decimal(10,2),",
						"          GrossRevenue as decimal(10,2),",
						"          ShippingCost as decimal(10,2),",
						"          NetRevenue as decimal(10,2),",
						"          CostOfGoods as decimal(10,2),",
						"          GrossProfit as decimal(10,2),",
						"          PaymentMethod as string,",
						"          OrderStatus as string,",
						"          IsDelivered as boolean,",
						"          Region as string,",
						"          LoadedAt as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> factOrders",
						"source(output(",
						"          CustomerId as string,",
						"          FirstName as string,",
						"          LastName as string,",
						"          Email as string,",
						"          Phone as string,",
						"          City as string,",
						"          State as string,",
						"          Country as string,",
						"          CustomerSegment as string,",
						"          JoinDate as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> Customers",
						"source(output(",
						"          ProductId as string,",
						"          ProductName as string,",
						"          Category as string,",
						"          SubCategory as string,",
						"          Brand as string,",
						"          UnitPrice as integer,",
						"          CostPrice as integer,",
						"          StockQty as integer,",
						"          Supplier as string,",
						"          IsActive as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> Product",
						"factOrders, Customers join(factOrders@CustomerId == Customers@CustomerId,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> OrderwithCustomer",
						"OrderwithCustomer, Product join(factOrders@ProductId == Product@ProductId,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> withProductname",
						"withProductname derive(CostOfGoods = Quantity*CostPrice,",
						"          GrossProfit = NetRevenue-(Quantity*CostPrice),",
						"          ProfitMarginPct = (NetRevenue-Quantity*CostPrice)/100) ~> withProfit",
						"withProfit select(mapColumn(",
						"          OrderId,",
						"          CustomerId = factOrders@CustomerId,",
						"          ProductId = factOrders@ProductId,",
						"          CustomerName,",
						"          ProductName = factOrders@ProductName,",
						"          Category = factOrders@Category,",
						"          OrderDate,",
						"          OrderMonth,",
						"          OrderYear,",
						"          Quantity,",
						"          UnitPrice = factOrders@UnitPrice,",
						"          DiscountPct,",
						"          DiscountAmount,",
						"          GrossRevenue,",
						"          ShippingCost,",
						"          NetRevenue,",
						"          CostOfGoods,",
						"          GrossProfit,",
						"          PaymentMethod,",
						"          OrderStatus,",
						"          IsDelivered,",
						"          Region,",
						"          LoadedAt,",
						"          CustomerId = Customers@CustomerId,",
						"          FirstName,",
						"          LastName,",
						"          Email,",
						"          Phone,",
						"          City,",
						"          State,",
						"          Country,",
						"          CustomerSegment,",
						"          JoinDate,",
						"          ProductId = Product@ProductId,",
						"          ProductName = Product@ProductName,",
						"          Category = Product@Category,",
						"          SubCategory,",
						"          Brand,",
						"          UnitPrice = Product@UnitPrice,",
						"          CostPrice,",
						"          StockQty,",
						"          Supplier,",
						"          IsActive,",
						"          ProfitMarginPct",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          OrderId as string,",
						"          CustomerId as string,",
						"          ProductId as string,",
						"          CustomerName as string,",
						"          ProductName as string,",
						"          Category as string,",
						"          OrderDate as date,",
						"          OrderMonth as integer,",
						"          OrderYear as integer,",
						"          Quantity as integer,",
						"          UnitPrice as decimal(10,2),",
						"          DiscountPct as decimal(5,2),",
						"          DiscountAmount as decimal(10,2),",
						"          GrossRevenue as decimal(10,2),",
						"          ShippingCost as decimal(10,2),",
						"          NetRevenue as decimal(10,2),",
						"          CostOfGoods as decimal(10,2),",
						"          GrossProfit as decimal(10,2),",
						"          PaymentMethod as string,",
						"          OrderStatus as string,",
						"          IsDelivered as boolean,",
						"          Region as string,",
						"          LoadedAt as timestamp",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          OrderId,",
						"          CustomerId,",
						"          ProductId,",
						"          CustomerName,",
						"          ProductName,",
						"          Category,",
						"          OrderDate,",
						"          OrderMonth,",
						"          OrderYear,",
						"          Quantity,",
						"          UnitPrice,",
						"          DiscountPct,",
						"          DiscountAmount,",
						"          GrossRevenue,",
						"          ShippingCost,",
						"          NetRevenue,",
						"          CostOfGoods,",
						"          GrossProfit,",
						"          PaymentMethod,",
						"          OrderStatus,",
						"          IsDelivered,",
						"          Region,",
						"          LoadedAt",
						"     )) ~> LoadEnrichOrder"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_factOrders')]",
				"[concat(variables('factoryId'), '/datasets/ds_blob_customers')]",
				"[concat(variables('factoryId'), '/datasets/ds_blob_product')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_OrdersClensed')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_blob_orders",
								"type": "DatasetReference"
							},
							"name": "allOrders"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_sql_factOrders",
								"type": "DatasetReference"
							},
							"name": "LoadOrders"
						}
					],
					"transformations": [
						{
							"name": "CleanOrders"
						},
						{
							"name": "NewColumns"
						},
						{
							"name": "FinalOrders"
						}
					],
					"scriptLines": [
						"source(output(",
						"          OrderId as string,",
						"          CustomerId as string,",
						"          ProductId as string,",
						"          OrderDate as date 'yyyy-MM-dd',",
						"          Quantity as integer,",
						"          UnitPrice as integer,",
						"          Discount as integer,",
						"          ShippingCost as integer,",
						"          PaymentMethod as string,",
						"          OrderStatus as string,",
						"          Region as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     wildcardPaths:['orders/month*/orders_*.csv']) ~> allOrders",
						"allOrders filter((!isNull(OrderId) && length(trim(OrderId))>0)) ~> CleanOrders",
						"CleanOrders derive(GrossRevenue = Quantity * UnitPrice,",
						"          DiscountAmount = Quantity *UnitPrice*Discount,",
						"          NetRevenue = Quantity*UnitPrice*(1-Discount),",
						"          TotalRevenue = (Quantity*UnitPrice*(1-Discount))+ShippingCost,",
						"          IdDeliverd = equals(OrderStatus, 'Delivered'),",
						"          OrderYear = year(OrderDate),",
						"          OrderMonth = month(OrderDate)) ~> NewColumns",
						"NewColumns select(mapColumn(",
						"          OrderId,",
						"          CustomerId,",
						"          ProductId,",
						"          OrderDate,",
						"          Quantity,",
						"          UnitPrice,",
						"          Discount,",
						"          ShippingCost,",
						"          PaymentMethod,",
						"          OrderStatus,",
						"          Region,",
						"          GrossRevenue,",
						"          DiscountAmount,",
						"          NetRevenue,",
						"          TotalRevenue,",
						"          IdDeliverd,",
						"          OrderYear,",
						"          OrderMonth",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> FinalOrders",
						"FinalOrders sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          OrderId as string,",
						"          CustomerId as string,",
						"          ProductId as string,",
						"          CustomerName as string,",
						"          ProductName as string,",
						"          Category as string,",
						"          OrderDate as date,",
						"          OrderMonth as integer,",
						"          OrderYear as integer,",
						"          Quantity as integer,",
						"          UnitPrice as decimal(10,2),",
						"          DiscountPct as decimal(5,2),",
						"          DiscountAmount as decimal(10,2),",
						"          GrossRevenue as decimal(10,2),",
						"          ShippingCost as decimal(10,2),",
						"          NetRevenue as decimal(10,2),",
						"          CostOfGoods as decimal(10,2),",
						"          GrossProfit as decimal(10,2),",
						"          PaymentMethod as string,",
						"          OrderStatus as string,",
						"          IsDelivered as boolean,",
						"          Region as string,",
						"          LoadedAt as timestamp",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          OrderId,",
						"          CustomerId,",
						"          ProductId,",
						"          OrderDate,",
						"          OrderMonth,",
						"          OrderYear,",
						"          Quantity,",
						"          UnitPrice,",
						"          DiscountAmount,",
						"          GrossRevenue,",
						"          ShippingCost,",
						"          NetRevenue,",
						"          PaymentMethod,",
						"          OrderStatus,",
						"          Region",
						"     )) ~> LoadOrders"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_blob_orders')]",
				"[concat(variables('factoryId'), '/datasets/ds_sql_factOrders')]"
			]
		}
	]
}